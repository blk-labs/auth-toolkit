{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "ESNext",
    "composite": true,
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "types": ["vite/client"],
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    
    /* Add these two settings to resolve module errors */
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,

    "baseUrl": ".",
    "rootDir": "../../",
    "paths": {
      "@/*": ["./src/*"],
      "@auth-toolkit/core": ["../../packages/core/src/index.ts"],
      "@auth/types": ["../../packages/core/src/types/index.ts"],
      "@blk-auth-toolkit/react": ["../../packages/react/src/index.ts"]
    }
  },
  "include": [
    "src",
    "src/**/*.json",
    "../../packages/core/src",
    "../../packages/react/src"
  ],
  "exclude": ["../../packages/react/src/__tests__"]
}